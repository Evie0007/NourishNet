# Used by `npm run build` — i.e. every Vercel production build.
#
# Not a secret: this is a public API URL that ships inside the JS bundle
# either way. Committing it means the deploy works from a git push alone,
# with nothing to configure in the Vercel dashboard.
#
# A VITE_API_URL set in Vercel's Environment Variables overrides this file,
# so the dashboard is still available if you need to point a deployment
# somewhere else without a commit.
#
# Local `npm run dev` ignores this file and uses frontend/.env instead.
VITE_API_URL=https://nourishnet-api-l8ub.onrender.com
