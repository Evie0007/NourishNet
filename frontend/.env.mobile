# Loaded by `npm run dev:mobile` (vite --mode mobile), for testing the
# barcode scanner on a phone.
#
# A relative base, not a host: the app calls its own origin and the Vite
# dev server proxies /api to the backend (see vite.config.js). That way the
# phone only needs to reach one address, and because the requests are
# same-origin the backend's CORS_ORIGINS never has to learn about it.
#
# Not used by `npm run dev` or by production builds, which read .env and
# .env.production respectively.
VITE_API_URL=/api
