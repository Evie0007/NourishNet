# Copy to .env and fill in real values. .env is gitignored; this file is not,
# so never put a real secret here.

# --- Database ---
# PostgreSQL is the target. A `postgres://` or `postgresql://` URL from a
# hosting provider is rewritten automatically — paste whatever they give you.
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/postgres

# Zero-setup local alternative (no Postgres server needed). Fine for building
# screens; it will not reproduce Postgres locking, so test anything about
# concurrency — the reservation claim, the expiration sweep — against Postgres.
# DATABASE_URL=sqlite:///./nourishnet.db

# Connection pool. Every worker gets its own pool, so a 4-worker deploy at
# these numbers can hold 60 connections — keep the total under the server's
# max_connections.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=1800

# Per-query timeout in milliseconds. Leave unset when connecting through a
# transaction-mode pooler (Supabase, PgBouncer): they can reject the startup
# parameter this uses and fail every connection. Prefer setting it on the
# database role instead: ALTER ROLE <user> SET statement_timeout = '15s';
# DB_STATEMENT_TIMEOUT_MS=15000

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
STAFF_TOKEN_HOURS=8
ORG_TOKEN_HOURS=24

# --- CORS ---
# Comma-separated frontend origins. Add your deployed Vercel URL here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Demo accounts (read by scripts/seed_demo.py) ---
DEMO_STAFF_PASSWORD=
DEMO_ORG_PASSWORD=
# Optional overrides; these are the defaults:
# DEMO_STAFF_EMAIL=nourishnet26+staff@gmail.com
# DEMO_ORG_EMAIL=nourishnet26+organizer@gmail.com

# --- Google Cloud Vision (OCR date scanner) ---
# Unset is a supported state: label reads come back empty and intake falls
# back to typing the date. It never blocks receiving.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-vision-key.json

# --- Automatic expiration rules ---
# The background sweep that moves items through the lifecycle as their
# deadlines pass. Turn it off only if you run `python -m scripts.sweep` from
# a real scheduler instead — off with nothing replacing it means no item ever
# changes status on its own.
SWEEP_ENABLED=true
SWEEP_INTERVAL_SECONDS=60

# --- UPC lookup ---
# Off by default: intake must not depend on a third-party API being up. When
# on, an unknown barcode is looked up once and cached in the catalog, so the
# next unit off the same pallet resolves instantly and offline.
UPC_LOOKUP_ENABLED=false
# UPC_LOOKUP_URL=https://world.openfoodfacts.org/api/v2/product/{upc}.json
# UPC_LOOKUP_TIMEOUT_SECONDS=3
